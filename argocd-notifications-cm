apiVersion: v1
kind: ConfigMap
metadata:
  name: argocd-notifications-cm
  namespace: argocd
data:
  trigger.on-deployed: |
    - when: app.status.sync.status == 'Synced'
      send: [slack-notification]
  template.slack-notification: |
    message: |
      :white_check_mark: Oracle DB Pipeline Sync Succeeded!
      *App:* {{.app.metadata.name}}
      *Target DB:* 192.168.1.184
  service.slack: |
    token: $slack-token
    channel: #deployments
